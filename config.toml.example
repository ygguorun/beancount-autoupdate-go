[telegram]
# Telegram Bot Token (从环境变量 TELEGRAM_BOT_TOKEN 读取)
token = ""

# 允许的用户 ID 列表（可选，留空则允许所有用户）
allowed_user_ids = []

# 是否在确认提交后删除用户发送的图片消息
delete_user_message = false

# 普通交易确认提交后是否发送成功消息
send_confirmation_message = true

# 特殊指令确认提交后是否发送成功消息
send_directive_confirmation_message = true

[llm]
# LLM API 配置
base_url = "https://xxx.com/api/"
model = "glm-4.6v-flash"
api_key = ""  # 从环境变量 LLM_API_KEY 读取

# LLM 超时设置（秒）
timeout = 60

# 扩展 prompt 配置（可选）
# 支持 TOML 的三种多行字符串语法：
#
# 方式1: 使用普通字符串 + \n 转义（适合简单的多行文本）
# extend_prompt = 'append:请特别注意识别发票号码和税号\n并将它们包含在 extra 字段中\n\n另外，注意识别交易的具体时间'
#
# 方式2: 使用三重引号 """（支持转义序列，适合包含变量或转义字符的文本）
# extend_prompt = """
# append:请特别注意识别以下信息：
# 1. 发票号码 - 包含在 extra.invoice_number
# 2. 税号 - 包含在 extra.tax_id
# 3. 交易地点 - 包含在 extra.transaction_location
# """
#
# 方式3: 使用三重撇号 '''（不支持转义，适合原始文本，注意换行）
# extend_prompt = '''
# append:请特别注意识别以下信息：
# 1. 发票号码
# 2. 税号
# 3. 交易地点
# '''
#
# 模式说明:
# - "append": 在原有 prompt 基础上追加新的 prompt
# - "replace": 使用新的 prompt 完全替换原有 prompt
extend_prompt = ""

[beancount]
# Beancount 数据目录路径
data_dir = "beancount"

# 全局选项
title = "个人财务账本"
operating_currency = "CNY"

[git]
# Git 远程仓库地址
repo_url = "git@github.com:username/beancount.git"

# 自动提交配置
auto_commit = true
commit_message_prefix = "Add transaction:"

# 推送配置
auto_push = true
push_timeout = 30

# 冲突处理策略：abort, ours, theirs
conflict_strategy = "abort"

[logging]
# 日志配置
level = "INFO"
log_dir = "logs"
log_file = "beancount-autoupdate.log"
max_bytes = 10485760  # 10MB
backup_count = 5

[webdav]
# WebDAV 配置（可选）
enabled = true  # 是否启用 WebDAV 上传
url = "https://your-webdav-server.com/dav"  # WebDAV 服务器 URL
username = ""  # 用户名（从环境变量 WEBDAV_USERNAME 读取）
password = ""  # 密码（从环境变量 WEBDAV_PASSWORD 读取）
path = "path/to/receipts"  # 上传路径
filename_template = "{datetime}_{order_id}_{uuid}.jpg"  # 文件名模板，支持变量: {date}, {order_id}, {datetime}, {uuid}
verify_ssl = true  # 是否验证 SSL 证书